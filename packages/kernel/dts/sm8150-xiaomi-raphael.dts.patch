From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: sm8150-xiaomi-raphael: drop redundant overrides

Three blocks in the upstream board DTS cannot resolve against this tree:

  * &ipa            - the IPA node only exists on the soc/qualcomm-sm8150
                      branch "andrew/6.16-ipa", not on the main branch.
  * &pm8150_rtc     - the rtc@6000 node carries no pm8150_rtc label, but
                      patches/0102-...-nvmem-support already sets the same
                      nvmem-cells/nvmem-cell-names properties on it.
  * &pm8150_sdam_2  - the same patch already defines the pm8150_sdam_2 node
                      and its rtc_offset child; redefining rtc_offset here
                      would duplicate the label.

Dropping them keeps the DTB buildable; the resulting behaviour matches what
the board DTS intended (RTC offset nvmem wired, SDAM enabled).

---
index eaf9f7f..dae6618 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-raphael.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-raphael.dts
@@ -549,13 +549,6 @@
 	};
 };
 
-&ipa {
-	status = "okay";
-	qcom,gsi-loader = "self";
-	memory-region = <&ipa_fw_mem>;
-	firmware-name = "qcom/sm8150/Xiaomi/raphael/ipa_fws.mbn";
-};
-
 &mdss_dsi0 {
 	vdda-supply = <&vdda_mipi_dsi0_1p2>;
 	status = "okay";
@@ -604,19 +597,6 @@
 	};
 };
 
-&pm8150_rtc {
-       nvmem-cells = <&rtc_offset>;
-       nvmem-cell-names = "offset";
-       status = "okay";
-};
-
-&pm8150_sdam_2 {
-       status = "okay";
-       rtc_offset: rtc-offset@bc {
-               reg = <0xbc 0x4>;
-       };
-};
-
 &pm8150b_typec {
 	vdd-vbus-supply = <&pm8150b_vbus>;
 	vdd-pdphy-supply = <&vdda_usb_hs_3p1>;
